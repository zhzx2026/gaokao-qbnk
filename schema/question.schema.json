{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhzx2026/gaokao-qbnk/schema/question.schema.json",
  "title": "QBNK 题目记录",
  "description": "高考题库（gaokao-qbnk）单条题目记录规范。核心原则：每条题目必须可溯源，无明确来源者一律不入正式库。",
  "type": "object",
  "required": ["id", "schema_version", "subject", "stage", "exam_type", "year", "type", "stem", "source", "verification"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^q-[0-9]{4}-[a-z]+-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "稳定题号：q-<年份>-<学科码>-<卷别码>-<序号>，由 qbnk new-id 生成"
    },
    "schema_version": { "type": "string", "const": "1.0" },
    "subject": { "$ref": "#/$defs/subject" },
    "stage": { "$ref": "#/$defs/stage" },
    "exam_type": { "$ref": "#/$defs/examType" },
    "year": { "type": "integer", "minimum": 0, "maximum": 2100, "description": "0 = 年份未知（仅隔离区记录允许）" },
    "region": { "type": "string", "description": "省级行政区或“全国”；缺则填“未知”" },
    "paper": { "type": "string", "description": "卷别，如：全国I卷、新课标II卷、北京卷、浙江卷（1月）" },
    "paper_id": { "type": "string", "description": "所属试卷 id，对应 data/papers/*.jsonl" },
    "question_no": { "type": "string", "description": "原卷题号，如 22 / 三(1) / 16-Ⅱ" },
    "type": { "$ref": "#/$defs/questionType" },
    "stem": { "type": "string", "minLength": 1, "description": "题干；含材料题的材料全文（材料另见 materials 时可只放设问）" },
    "materials": {
      "type": "array",
      "description": "阅读/听力等材料原文",
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "text": { "type": "string" },
          "source_ref": { "type": "string", "description": "材料出处（作者/篇目/年份），有则填" }
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "text"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "answer": {
      "description": "客观题标准答案；单选为字符串，多选为字符串数组，其余为 null",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "null" }
      ]
    },
    "answer_text": { "type": ["string", "null"], "description": "主观题参考答案或评分说明" },
    "analysis": { "type": ["string", "null"], "description": "解析；必须来自 source 或 evidence 中列出的权威出处" },
    "score": { "type": ["number", "null"] },
    "difficulty": { "type": ["integer", "null"], "minimum": 1, "maximum": 5, "description": "1-5；无可靠依据时留 null，禁止凭感觉填" },
    "knowledge_points": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": { "$ref": "#/$defs/source" },
    "verification": { "$ref": "#/$defs/verification" },
    "content_hash": { "type": "string", "pattern": "^sha1:[0-9a-f]{40}$", "description": "由 qbnk validate --fix-hash 计算：stem|options|answer 归一化后的 sha1" },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "notes": { "type": "string", "description": "人工备注，如“原文为图片，OCR 待核”" }
  },
  "$defs": {
    "subject": {
      "type": "string",
      "enum": ["语文", "数学", "英语", "物理", "化学", "生物", "政治", "历史", "地理", "技术", "综合", "其他"]
    },
    "stage": {
      "type": "string",
      "enum": ["高考", "高三", "高二", "高一", "其他"],
      "description": "高考=正式高考真题；其余为中学阶段同步/模拟题"
    },
    "examType": {
      "type": "string",
      "enum": ["真题", "模拟", "联考", "期中", "期末", "月考", "学业水平", "竞赛", "教材习题", "其他"]
    },
    "questionType": {
      "type": "string",
      "enum": [
        "单选", "多选", "判断", "填空", "解答", "计算", "证明", "实验",
        "写作", "微写作", "翻译", "完形", "阅读", "语用", "古诗文默写",
        "材料分析", "开放性", "选做", "其他"
      ]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "name", "url", "tier", "fetched_at"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "description": "对应 sources/registry.json 中的 id" },
        "name": { "type": "string", "description": "来源名称（含发布机构与篇名）" },
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tier": { "$ref": "#/$defs/tier" },
        "published_at": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date" },
        "license": { "type": "string", "description": "该来源的版权/授权状态，见 docs/sources.md" },
        "evidence": {
          "type": "array",
          "description": "交叉验证用的其他权威出处",
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "name": { "type": "string" },
              "tier": { "$ref": "#/$defs/tier" },
              "checked_at": { "type": "string", "format": "date" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "tier": {
      "type": "string",
      "enum": ["T1", "T2", "T3", "T4"],
      "description": "T1 命题机构官方；T2 官方授权媒体/考试院合作平台；T3 大型教育媒体/教辅机构整理；T4 社区或二次转载，必须交叉验证"
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "single_source", "conflict", "rejected"],
          "description": "verified=≥2 个独立来源一致 / single_source=仅单一来源 / conflict=来源互相矛盾 / rejected=不采信，禁止使用"
        },
        "method": { "type": "string" },
        "checked_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
