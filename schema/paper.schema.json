{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zhzx2026/gaokao-qbnk/schema/paper.schema.json",
  "title": "QBNK 试卷记录",
  "description": "一份试卷（真题/模拟卷/联考卷）的元数据记录。试卷是题目的归属单位，题目通过 paper_id 关联。",
  "type": "object",
  "required": ["id", "schema_version", "title", "subject", "stage", "exam_type", "year", "source"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^p-[0-9]{4}-[a-z]+-[a-z0-9]+(-[a-z0-9]+)*$" },
    "schema_version": { "type": "string", "const": "1.0" },
    "title": { "type": "string", "description": "试卷全名，如：2026年普通高等学校招生全国统一考试 语文（全国I卷）" },
    "subject": { "type": "string", "enum": ["语文", "数学", "英语", "物理", "化学", "生物", "政治", "历史", "地理", "技术", "综合", "其他"] },
    "stage": { "type": "string", "enum": ["高考", "高三", "高二", "高一", "其他"] },
    "exam_type": { "type": "string", "enum": ["真题", "模拟", "联考", "期中", "期末", "月考", "学业水平", "竞赛", "其他"] },
    "year": { "type": "integer", "minimum": 1951, "maximum": 2100 },
    "region": { "type": "string" },
    "paper": { "type": "string", "description": "卷别：全国I卷 / 新课标II卷 / 北京卷 ..." },
    "exam_system": { "type": "string", "enum": ["新高考", "老高考", "未知"], "default": "未知" },
    "duration_minutes": { "type": ["integer", "null"] },
    "total_score": { "type": ["number", "null"] },
    "question_ids": { "type": "array", "items": { "type": "string" }, "description": "已入库题目 id（有序）" },
    "structure": {
      "type": "array",
      "description": "试卷结构：大题 -> 小题数量/分值/题型",
      "items": {
        "type": "object",
        "required": ["section"],
        "additionalProperties": false,
        "properties": {
          "section": { "type": "string" },
          "type": { "type": "string" },
          "count": { "type": "integer" },
          "score_each": { "type": "number" },
          "note": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "name", "url", "tier", "fetched_at"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string" },
        "name": { "type": "string" },
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tier": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
        "published_at": { "type": "string" },
        "fetched_at": { "type": "string", "format": "date" },
        "license": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "name": { "type": "string" },
              "tier": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
              "checked_at": { "type": "string", "format": "date" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["verified", "single_source", "conflict", "rejected"] },
        "method": { "type": "string" },
        "checked_at": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "artifact": {
      "type": ["object", "null"],
      "description": "原卷文件（PDF/图片）位置或外链，仓库不直接存放大文件",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["pdf", "image", "docx", "html", "none"] },
        "url": { "type": "string" },
        "local_path": { "type": "string" },
        "sha256": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" }
  }
}
